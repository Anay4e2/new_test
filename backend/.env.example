# ===========================================
# Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001

# MongoDB Connection
# Local: mongodb://localhost:27017/trip_planner
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/trip_planner
MONGO_URI=mongodb://localhost:27017/trip_planner

# SMTP Configuration (for email export)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Trip Planner <your-email@gmail.com>

# External API Keys (optional - for enhanced features)
# RapidAPI key for train/distance services
# RAPIDAPI_KEY=your_rapidapi_key_here

# Google Maps API Key (if using server-side geocoding)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
