# ===========================================
# Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001

# JWT Authentication (REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost

# MongoDB Connection
# Local: mongodb://localhost:27017/trip_planner
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/trip_planner
MONGO_URI=mongodb://localhost:27017/trip_planner

# SMTP Configuration (for email export)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Trip Planner <your-email@gmail.com>

# External API Keys (optional - for enhanced features)
# RapidAPI key for train/distance services (sign up at https://rapidapi.com/hub)
# Used for: IRCTC train search, PNR status, live train status, distance calculations
# Without this key, train features fall back to mock data
# RAPIDAPI_KEY=your_rapidapi_key_here

# Google Maps API Key (if using server-side geocoding)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Exchange Rate API key for live currency conversion (https://exchangerate-api.com/)
# Without this key, currency conversion uses static/hardcoded rates
# EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# Google OAuth (for "Sign in with Google" feature)
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your_google_client_id_here

# Cloudinary (for image, video, and PDF uploads)
# Sign up at https://cloudinary.com/ — free tier includes 25GB storage
# Without these, uploads store as base64 fallback (not recommended for production)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
