# ===========================================
# Frontend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Google Maps API Key (required for map functionality)
# Get your key from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Places API, Directions API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Note: Weather data is fetched from Open-Meteo API (free, no key required)
# Coordinates are obtained via Google Geocoding API (uses same key as above)

# Backend API URL (optional - defaults to localhost:3001)
# VITE_API_URL=http://localhost:3001/api
